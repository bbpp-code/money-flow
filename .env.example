# Explicit local-only demo. Set false only after all live credentials are configured.
DEMO_MODE=true
DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=you@example.com

# Google Sheets / Docs server-side service account (JSON stored as a single escaped line)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DOC_ID=1-_wsfIz2I99zozOqsv6CaqPNir2eZ1a6eTVerGsq8_I

# Store only SHA-256 hashes. Generate with: printf %s 'token' | shasum -a 256
DEVICE_API_KEY_HASHES=
CRON_SECRET=

# Exchange-rate API; Frankfurter is ECB-reference-data based.
FX_API_BASE_URL=https://api.frankfurter.app
NEXT_PUBLIC_APP_NAME=MONEYFLOW JAPAN
